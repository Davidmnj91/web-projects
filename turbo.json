{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "clean": {},
    "build": {
      "dependsOn": ["lint", "^build"],
      "outputs": [".next/**", "dist/**", ".vercel/output/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "APP_DOMAIN",
    "BASE_URL",
    "NEXT_PUBLIC_GA_ID",
    "MAIL_CLIENT_ID",
    "MAIL_CLIENT_SECRET",
    "MAIL_USER",
    "OAUTH_ACCESS_TOKEN",
    "OAUTH_REDIRECT_URL",
    "OAUTH_REFRESH_TOKEN",
    "MAIL_HOST",
    "MAIL_PORT",
    "MAIL_PASSWORD",
    "YOUTUBE_API_KEY",
    "YOUTUBE_CHANEL_ID",
    "NEXT_PUBLIC_RE_CAPTCHA_SITE_KEY",
    "RE_CAPTCHA_PRIVATE_KEY",
    "RE_CAPTCHA_DISABLED",

    "CLOUDINARY_CLOUD_NAME",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET"
  ]
}
